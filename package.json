{
  "name": "bloomy-app-design-space",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-native.mjs && vite --host 127.0.0.1 --port 5217",
    "build": "npm run build:native && tsc --noEmit && vite build",
    "check": "node scripts/generate-variation-cases.mjs && node --test tests/*.test.mjs && cd flutter_preview && flutter analyze --no-pub && flutter test --no-pub && cd .. && npm run build",
    "handoff": "node scripts/handoff.mjs",
    "dev:host": "vite --host 127.0.0.1 --port 5217",
    "build:native": "node scripts/build-native.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "prettier": "^3.9.9",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
